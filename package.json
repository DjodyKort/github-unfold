{
  "name": "github-unfold",
  "version": "0.1.0",
  "description": "Zero-click, self-healing expander for collapsed GitHub PR/issue comments and conversations.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Djody Kort",
  "homepage": "https://github.com/DjodyKort/github-unfold",
  "repository": {
    "type": "git",
    "url": "https://github.com/DjodyKort/github-unfold.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:probe": "node scripts/build-probe.mjs",
    "sentinel": "npm run build:probe && playwright test",
    "icons": "node scripts/render-icons.mjs",
    "e2e": "npm run build && node scripts/e2e-extension.mjs",
    "e2e:ci": "npm run build && node scripts/e2e-hermetic.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
